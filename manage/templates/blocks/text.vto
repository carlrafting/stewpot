<form method="post" action="/document/{{ document.id }}/blocks/{{ block.id }}/update/" data-block-editor data-block-type="text">
  <fieldset>
    <legend>Text block</legend>
    <label for="body-{{ block.id }}">Text</label>
    <textarea id="body-{{ block.id }}" name="body" rows="5">{{ block.content.body }}</textarea>
    <button>Save block</button>
  </fieldset>
</form>
<div class="block-preview" data-block-preview="text" aria-live="polite">
  <p>Text preview</p>
</div>
