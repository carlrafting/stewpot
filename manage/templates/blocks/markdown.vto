<form method="post" action="/document/{{ document.id }}/blocks/{{ block.id }}/update/" data-block-editor data-block-type="markdown">
  <fieldset>
    <legend>Markdown block</legend>
    <label for="body-{{ block.id }}">Markdown</label>
    <textarea id="body-{{ block.id }}" name="body" rows="8">{{ block.content.body }}</textarea>
    <button>Save block</button>
  </fieldset>
</form>
<div class="block-preview markdown-preview" data-block-preview="markdown" aria-live="polite">
  <p>Markdown preview</p>
</div>
