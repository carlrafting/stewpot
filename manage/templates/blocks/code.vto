<form method="post" action="/document/{{ document.id }}/blocks/{{ block.id }}/update/" data-block-editor data-block-type="code">
  <fieldset>
    <legend>Code block</legend>
    <label for="body-{{ block.id }}">Code</label>
    <textarea id="body-{{ block.id }}" name="body" rows="8" spellcheck="false">{{ block.content.body }}</textarea>
    <button>Save block</button>
  </fieldset>
</form>
<div class="block-preview" data-block-preview="code" aria-live="polite">
  <pre><code>Code preview</code></pre>
</div>