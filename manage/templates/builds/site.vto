{{ layout "layouts/page.vto" }}

{{ if error }}
<p role="alert">{{ error }}</p>
{{ /if }}

<p>Site directory: <code>{{ site.path || "." }}</code></p>
<p>Generator: {{ if selectedAdapter }}{{ selectedAdapter.name }}{{ else }}{{ site.adapter }}{{ /if }}</p>
<p>Manage inspects existing output; run your usual build command to generate or refresh it. Project code is not executed by Manage.</p>

<form action="/build/{{ site.id }}/update/" method="post">
  <label for="output-directory">Existing generated output folder (relative to site directory)</label>
  <input id="output-directory" name="outputDirectory" required value="{{ site.outputDirectory }}">
  <button type="submit">Inspect this output folder</button>
</form>

{{ if inspection }}
<h2>Project inspection</h2>
<p>Supported project detected: {{ if inspection.projectDetected }}yes{{ else }}no{{ /if }}</p>
<p>Config file(s): {{ if inspection.configFiles.length }}{{ inspection.configFiles.join(", ") }}{{ else }}none detected{{ /if }}</p>
<p>Lume detection checks for <code>_config.ts</code>, <code>_config.js</code>, <code>_config.mjs</code>, or <code>_config.tsx</code> with a literal import containing <code>lume</code>; other config patterns may not be detected.</p>
{{ for check of inspection.checks }}
<p>{{ check.label }}: {{ check.value }}</p>
{{ /for }}
<p>Configured output directory: <code>{{ inspection.outputDirectory }}</code></p>
<p>Output path exists: {{ if inspection.outputExists }}yes{{ else }}no{{ /if }}</p>
{{ if inspection.outputExists && !inspection.outputIsDirectory }}
<p role="alert">The configured output path is not a directory.</p>
{{ /if }}
<p>Output directory exists: {{ if inspection.outputIsDirectory }}yes{{ else }}no{{ /if }}</p>
{{ if inspection.outputIsDirectory }}
  {{ if inspection.previewAvailable }}
  <p><a href="/build/{{ site.id }}/preview/" target="_blank" rel="noopener">Preview generated site (scripts disabled)</a></p>
  <iframe title="Generated site preview" src="/build/{{ site.id }}/preview/" sandbox="allow-same-origin" referrerpolicy="no-referrer" loading="lazy" style="width: 100%; min-height: 32rem"></iframe>
  {{ else }}
  <p>No <code>index.html</code> is present to preview.</p>
  {{ /if }}
  {{ if inspection.outputEntries.length }}
  <ul>
    {{ for entry of inspection.outputEntries }}
    <li>{{ if entry.isDirectory }}Directory{{ else }}File{{ /if }}: {{ entry.name }}</li>
    {{ /for }}
  </ul>
  {{ else }}
  <p>The output directory is empty.</p>
  {{ /if }}
  {{ if inspection.outputEntriesTruncated }}
  <p>Showing only the first 50 entries.</p>
  {{ /if }}
{{ else }}
<p>That generated output folder does not exist yet. Run your usual site build command, then inspect again.</p>
{{ /if }}
<p>Manage does not evaluate the Lume config to infer the output location. The folder above is the generated output location you supplied.</p>
{{ /if }}

{{ /layout }}
