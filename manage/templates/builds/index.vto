{{ layout "layouts/page.vto" }}

{{ if error }}
<p role="alert">{{ error }}</p>
{{ /if }}

{{ if !workspaceRoot }}
<p>Build inspection is not configured. Set <code>builds.workspaceRoot</code> when creating the Manage app and grant Deno read access to that directory.</p>
{{ else }}
<p>Workspace root: <code>{{ workspaceRoot }}</code></p>
<p>Current directory: <code>{{ currentPath || "." }}</code></p>
{{ if parentHref }}
<p><a href="{{ parentHref }}">Up one directory</a></p>
{{ /if }}
<h2>Inspect a site</h2>
<form action="/builds/create/" method="post">
  <input type="hidden" name="path" value="{{ currentPath }}">
  <input type="hidden" name="name" value="{{ currentName }}">
  <input type="hidden" name="adapter" value="lume">
  <label for="root-output">Existing generated output folder (relative to this site, for example <code>_site</code> or <code>dist</code>)</label>
  <input id="root-output" name="outputDirectory" required placeholder="_site or dist">
  <button type="submit">Inspect current directory</button>
</form>
{{ if directories.length }}
<ul>
  {{ for directory of directories }}
  <li>
    <a href="{{ directory.href }}">{{ directory.name }}</a>
    <form action="/builds/create/" method="post">
      <input type="hidden" name="path" value="{{ directory.path }}">
      <input type="hidden" name="name" value="{{ directory.name }}">
      <input type="hidden" name="adapter" value="lume">
      <label>Existing generated output folder (relative to {{ directory.name }})
        <input name="outputDirectory" required placeholder="_site or dist">
      </label>
      <button type="submit">Inspect site</button>
    </form>
  </li>
  {{ /for }}
</ul>
{{ else }}
<p>No subdirectories found.</p>
{{ /if }}
{{ if directoriesTruncated }}
<p>Showing only the first 100 subdirectories. Narrow the current directory to see more.</p>
{{ /if }}
{{ /if }}

{{ if sites }}
<h2>Sites being inspected</h2>
<ul>
  {{ for site of sites }}
  <li><a href="/build/{{ site.id }}/">{{ site.name }}</a> ({{ site.path || "." }})</li>
  {{ /for }}
</ul>
{{ /if }}

{{ /layout }}
