{{ layout "layouts/page.vto" }}

{{ if document }}
{{ if blockAdded }}
<p class="notice" role="status">{{ blockAdded }}</p>
{{ /if }}
<form action="/document/{{ document.id }}/update/" method="post" class="document-form">
  <div class="field">
    <label for="title">Title</label>
    <input id="title" type="text" name="title" required value="{{ document.title }}">
    <label class="inline-field" for="draft">
      <input id="draft" type="checkbox" name="draft" {{ if document.draft }}checked{{ /if }}>
      Draft
    </label>
  </div>
  <button>Save Document</button>
</form>

<form action="/document/{{ document.id }}/blocks/new/" method="post" class="add-block-form">
  <fieldset>
    <legend>Add block</legend>
    <label for="type">Block type</label>
    <select name="type" id="type">
      {{ for type of blockTypes }}
        <option value="{{ type }}">{{ type }}</option>
      {{ /for }}
    </select>
    <button>Add block</button>
  </fieldset>
</form>

<p class="editor-status" role="status" aria-live="polite" data-editor-status></p>
<section class="block-list" aria-label="Document blocks" data-block-list>
  {{ for block of blocks }}
  <article class="block-card" data-block-id="{{ block.id }}">
    <div class="block-toolbar">
      <span class="drag-handle" aria-hidden="true">Move</span>
      <form action="/document/{{ document.id }}/blocks/order/" method="post" class="move-block-form">
        <input type="hidden" name="blockId" value="{{ block.id }}">
        <button name="direction" value="up" aria-label="Move {{ block.type }} block up" {{ if block.order === 0 }}disabled{{ /if }}>Move up</button>
        <button name="direction" value="down" aria-label="Move {{ block.type }} block down" {{ if block.order === blocks.length - 1 }}disabled{{ /if }}>Move down</button>
      </form>
      <form action="/document/{{ document.id }}/blocks/{{ block.id }}/delete/" method="post">
        <button class="danger" aria-label="Delete {{ block.type }} block">Delete block</button>
      </form>
    </div>
    {{ include `blocks/${block.type}.vto` { block, document } }}
  </article>
  {{ /for }}
</section>
{{ else }}
<p>There's no document associated with this id.</p>
{{ /if }}

{{ /layout }}
