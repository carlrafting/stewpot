{{ layout "layouts/page.vto" }}

<form action="/documents/create/" method="post">
  {{ include "components/field.vto" { id: "title", name: "title", label: "Title", type: "text", placeholder: "New Document Title..." } }}
  {{ include "components/field.vto" { id: "path", name: "path", label: "Public path", type: "text", placeholder: "Optional; suggested from the title" } }}
  <div class="field">
    <input id="draft" type="checkbox" name="draft" checked>
    <label for="draft">Draft</label>
  </div>
  <div class="field">
    <button>Create Document</button>
  </div>
</form>

{{ /layout }}
