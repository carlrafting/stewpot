{{ layout "layouts/page.vto" }}

<div class="page-actions">
  <a class="button" href="./create/">New route</a>
</div>

{{ if data?.routes }}
<ul class="resource-list">
{{ for route of data.routes }}
  <li>
    <dl class="route-details">
      <div><dt>Name</dt><dd>{{ route.name }}</dd></div>
      <div><dt>Path</dt><dd><code>{{ route.path }}</code></dd></div>
      <div><dt>Type</dt><dd>{{ route.type }}</dd></div>
      <div><dt>Reference</dt><dd><code>{{ route.ref }}</code></dd></div>
    </dl>
  </li>
{{ /for }}
</ul>
{{ else }}
<div class="empty-state"><strong>No routes yet</strong>Routes you create will appear here.</div>
{{ /if }}

{{ /layout }}
