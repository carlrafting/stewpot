{{ layout "layouts/page.vto" }}

<section class="hero-card" aria-labelledby="welcome-title">
  <div class="hero-content">
    <span class="eyebrow">Your workspace</span>
    <h2 id="welcome-title">A calmer way to manage your content.</h2>
    <p>Bring documents, routes, and shared resources together in one clear, focused workspace.</p>
    <div class="page-actions">
      <a class="button" href="/documents/">Explore documents <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="/library/">Open library</a>
    </div>
  </div>
</section>

{{ /layout }}
