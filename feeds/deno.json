{
  "name": "@stewpot/feeds",
  "description": "Feed utilities and CLI",
  "version": "0.14.0",
  "license": "MIT",
  "exports": {
    ".": "./core/main.ts",
    "./cli": "./cli/main.ts"
  },
  "imports": {
    "@stewpot/html": "jsr:@stewpot/html@^0.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "feedsmith": "npm:feedsmith@^2.9.6"
  },
  "desktop": {
    "app": {
      "name": "@stewpot/feeds Desktop Reader"
    },
    "output": {
      "linux": "./build/reader.AppImage",
      "macos": "./build/reader.app",
      "windows": "./build/reader.msi"
    }
  },
  "publish": {
    "exclude": [
      "*_test.ts",
      "*.test.ts",
      "fixtures",
      "__snapshots__",
      "core/desktop.ts"
    ]
  },
  "tasks": {
    "dev:cli": {
      "description": "Run CLI in development mode",
      "env": [
        "STEWPOT_MODE"
      ],
      "command": "STEWPOT_MODE=development deno -P cli/main.ts"
    },
    "dev:reader": {
      "description": "Run CLI reader application for development",
      "command": "deno -P --watch=assets cli/main.ts reader"
    },
    "doc:lint": {
      "description": "Lint package export modules",
      "command": "deno doc --lint core/main.ts cli/main.ts"
    },
    "tests": {
      "description": "Run lints & tests",
      "command": "deno test -P --allow-run"
    }
  },
  "permissions": {
    "default": {
      "env": true,
      "read": true,
      "write": true,
      "net": true,
      "run": true
    }
  },
  "compile": {
    "include": ["assets", "templates"]
  }
}
